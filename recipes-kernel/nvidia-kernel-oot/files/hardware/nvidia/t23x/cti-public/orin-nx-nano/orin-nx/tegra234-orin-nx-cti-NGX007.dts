//        phy-names = "usb2-0","usb3-2";
//    };

    //pcie limit 3rd gen
    //14160000 Limit max of NVMe port to gen 3 to avoid AER errors
    pcie@14160000{
        max-link-speed=<0x3>;
    };

    };

};
